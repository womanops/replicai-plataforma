# Copie para .env e preencha. O .env NUNCA vai para o git.
#
# Só estão aqui as variáveis que o código realmente lê. Este arquivo já
# prometeu HIGGSFIELD_API_KEY e S3_* que nada lia — configuração que não
# existe é pior do que configuração faltando, porque parece resolvida.

# ---------------------------------------------------------------- obrigatórias

# O modelo que compõe a peça. Sem ela a plataforma funciona, mas cai para a
# régua determinística — confira em /saude qual está valendo.
ANTHROPIC_API_KEY=

# Assina a sessão de quem entra pela tela. Sem ela um segredo é sorteado ao
# subir: toda reinicialização desloga todo mundo, e duas réplicas da api não
# reconhecem a sessão uma da outra. /saude denuncia quando falta.
# Gere com:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
REPLICAI_SEGREDO=

# O endereço público. O certificado é pedido para este nome na Let's Encrypt.
# Em `localhost` serve sem certificado, que é o que se quer ao testar aqui.
DOMINIO=localhost

# ------------------------------------------------------------------- cobrança
# Asaas. Ele emite a nota fiscal junto da cobrança, que é o motivo de ter sido
# escolhido; Pix e boleto saem por taxa fixa baixa.
ASAAS_API_KEY=
# qualquer valor: é o segredo combinado que o Asaas manda de volta no aviso de
# pagamento. Sem ele, qualquer um na internet libera plano mandando um JSON.
ASAAS_AVISO_TOKEN=
# com qualquer valor, fala com o ambiente de testes do Asaas. Apague para
# cobrar de verdade.
ASAAS_AREIA=1

# -------------------------------------------------------------------- ajustes
# Teto da arte que sobe, em MB. O PSD é 85% do disco de um trabalho.
# REPLICAI_MAX_ARTE_MB=250

# Instalação de TESTE: a franquia do plano não barra nada. Ligue só na sua
# máquina, para poder rodar a mesma peça vinte vezes enquanto ajusta um
# detalhe. /saude e a tela dizem quando está ligado — ambiente que não cobra
# precisa dizer que não cobra.
# REPLICAI_SEM_LIMITE=1

# Depois de quantos dias o material bruto é apagado. As peças entregues, os
# vídeos e a apresentação ficam.
# REPLICAI_FAXINA_DIAS=30

# Onde o estado dos trabalhos é guardado. No contêiner, o volume /dados.
# STORAGE_DIR=./dados
# REDIS_URL=redis://localhost:6379/0

# O fundo generativo NÃO usa variável: a CLI do Higgsfield guarda o próprio
# login. Uma vez, no servidor:
#   docker compose run --rm worker higgsfield auth login

# A tela de entrada mostra dois caminhos para quem não tem conta: a página
# onde se assina e o contato para pedir demonstração. Enquanto estiverem
# vazios a porta diz só a frase, sem link — endereço inventado manda a pessoa
# para o nada. Preencha quando o domínio existir.
# O contato já vem preenchido com o mesmo da landing (contato@operandi.com.br);
# a página de planos espera o domínio.
# REPLICAI_SITE_PLANOS=https://.../#precos
# REPLICAI_CONTATO_DEMO=contato@operandi.com.br

# ---------------------------------------------------------------- contratação
# Criar conta na mão é entrada de ADMINISTRAÇÃO: sem este token o endereço
# /contas não funciona, e cliente nenhum passa por ele (cliente entra por
# /assinar, que abre a cobrança e só libera no pagamento aprovado).
# REPLICAI_ADMIN_TOKEN=

# O endereço do painel, como ele aparece no e-mail de acesso. Sem isto a carta
# diz apenas qual é o login, sem dizer onde entrar.
# REPLICAI_PAINEL=https://app.seudominio.com.br

# O envio de e-mail (acesso, convite de pessoa, aviso de atraso). Sem chave
# configurada o e-mail é GRAVADO EM ARQUIVO em dados/_correio e /saude avisa:
# o caminho inteiro funciona para testar, mas cliente nenhum recebe acesso.
# O remetente precisa ser de um domínio verificado no Resend.
# RESEND_API_KEY=
# REPLICAI_EMAIL_DE=ReplicAI <acesso@seudominio.com.br>

# Para onde vai o aviso de disco (e os avisos de operação que vierem). É
# endereço SEU, não de cliente: disco cheio não deixa a plataforma lenta, para
# a produção de peças. Sem isto, a faxina mede e registra, mas o aviso não sai
# e /saude diz "avisa: ninguém".
# REPLICAI_AVISO_PARA=

# Quantos workers de peça sobem. Numa máquina de 8 GB ponha 1: dois abrindo
# PSD ao mesmo tempo chegam a 7,3 GB e o sistema vai para o swap — a peça
# demora MAIS do que se tivesse esperado na fila. Com 16 GB, deixe o padrão (2).
# REPLICAI_WORKERS=1

# ------------------------------------------------------------- cópia diária
# Para onde vai a cópia diária do que é dos clientes — peças entregues,
# vídeos, apresentação e contas. É armazenamento de objetos (S3, Magalu
# Object Storage, Cloudflare R2, Backblaze B2: todos falam a mesma língua).
# Sem isto, NENHUMA cópia é feita e /saude diz "desligada".
# REPLICAI_COPIA_BUCKET=
# REPLICAI_COPIA_CHAVE=
# REPLICAI_COPIA_SEGREDO=
# endpoint só para quem não é AWS (ex.: https://br-se1.magaluobjects.com)
# REPLICAI_COPIA_ENDPOINT=
# REPLICAI_COPIA_REGIAO=us-east-1
# REPLICAI_COPIA_PREFIXO=replicai
# quantas cópias ficam guardadas lá (uma por dia)
# REPLICAI_COPIAS=14
