# Copie para .env e preencha. O .env NUNCA vai para o git.

REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./dados

# Higgsfield — a conta é da plataforma, não do cliente
# O modelo que compõe a peça. Sem ela a plataforma funciona, mas cai para a
# regra determinística — confira em /saude qual está valendo.
ANTHROPIC_API_KEY=

HIGGSFIELD_API_KEY=

# Storage de arquivos (S3 ou Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Cobrança — Asaas. Ele emite a nota fiscal junto da cobrança, que é o motivo
# de ter sido escolhido; Pix e boleto saem por taxa fixa baixa.
ASAAS_API_KEY=
# qualquer valor: é o segredo combinado que o Asaas manda de volta no aviso de
# pagamento. Sem ele, qualquer um na internet libera plano mandando um JSON.
ASAAS_AVISO_TOKEN=
# com qualquer valor, fala com o ambiente de testes do Asaas
ASAAS_AREIA=1

# Assina a sessão de quem entra pela tela. Sem ela, um segredo é sorteado ao
# subir e toda reinicialização desloga todo mundo — e dois servidores atrás do
# mesmo endereço não reconhecem a sessão um do outro.
# REPLICAI_SEGREDO=
